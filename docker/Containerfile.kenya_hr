# Kenya HR container image
#
# Stage 2 of a two-stage build.
#
#   Stage 1 (in frappe_docker): builds `erpnext-hrms:16` from docker/apps.json
#       using the official `images/layered/Containerfile`.
#   Stage 2 (this file): takes that image and copies this repository's
#       custom Kenya HR app into the bench `apps/` directory.
#
# Build from the repository root:
#
#   docker build \
#       -f docker/Containerfile.kenya_hr \
#       --build-arg BASE_IMAGE=erpnext-hrms:16 \
#       -t kenya-hr-stack:16 .
#
ARG BASE_IMAGE=erpnext-hrms:16
FROM ${BASE_IMAGE}

USER root

# Bring the Kenya HR app source into the bench and give it to the frappe user.
COPY apps/kenya_hr /home/frappe/frappe-bench/apps/kenya_hr
RUN chown -R frappe:frappe /home/frappe/frappe-bench/apps/kenya_hr \
    && rm -rf /home/frappe/frappe-bench/apps/kenya_hr/.git

USER frappe