# Copy to .env and adjust. Generated compose files read these variables.

# ---- ERPNext version (base image tag used for the core stack) -------------
# Use a released tag, e.g. v16.34.1
ERPNEXT_VERSION=v16.34.1

# ---- Database password (used by MariaDB and bench) ------------------------
DB_PASSWORD=ChangeMe_Strong_Password_1

# ---- Ports ----------------------------------------------------------------
# Port on which the ERPNext UI is served (HTTP, behind the nginx frontend).
HTTP_PUBLISH_PORT=8080
# HTTPS port is only used when the HTTPS/traefik overrides are enabled.
HTTPS_PUBLISH_PORT=443

# ---- Site resolution ------------------------------------------------------
# Leave empty when your site name matches the Host header (default behaviour).
# Set this to the site name if you want to reach `mysite` via another host.
FRAPPE_SITE_NAME_HEADER=

# ---- Custom image ---------------------------------------------------------
# Used by the docker-compose pipeline produced by scripts/deploy-docker.sh.
CUSTOM_IMAGE=kenya-erp-stack
CUSTOM_TAG=16
PULL_POLICY=never

# ---- Keycloak SSO (used with deploy-docker.sh --with-keycloak) -------------
KEYCLOAK_VERSION=23.0.4
# Host port for the Keycloak admin console / auth endpoints (ERPNext uses 8080).
KEYCLOAK_PUBLISH_PORT=18080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---- Production extras (documented in docs/02-docker-deployment.md) -------
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120
# UPSTREAM_REAL_IP_ADDRESS=